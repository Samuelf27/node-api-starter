# Copie para .env e ajuste conforme necessário
NODE_ENV=development
PORT=3000

# Segredos JWT (gere valores fortes em produção!)
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Banco de dados (apenas se usar o caminho com Prisma/PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
